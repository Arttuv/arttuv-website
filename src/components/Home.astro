---
import { Image } from "astro:assets"
import arttu from "../images/arttuv-bw.jpeg"
import { getCollection } from "astro:content"
import type { CollectionEntry } from "astro:content"
import MarginaliaEntry from "./MarginaliaEntry.astro"
import Story from "./Story.astro"
import { featuredGroups } from "../config/featured"

const marginalia = (await getCollection("marginalia")).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
const allWritings = (await getCollection("writings")).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())

const postMap = new Map(allWritings.map((post) => [post.id, post]))

const resolvedGroups = featuredGroups.map((group) => ({
  ...group,
  posts: group.slugs
    .map((slug) => postMap.get(slug))
    .filter((post): post is CollectionEntry<"writings"> => Boolean(post)),
}))

// The first group's spotlight opens the page; every other featured post is a card under its theme.
const featuredPost = resolvedGroups[0]?.spotlight ? postMap.get(resolvedGroups[0].spotlight) : undefined
const themes = resolvedGroups
  .map((group) => ({ ...group, posts: group.posts.filter((post) => post.id !== featuredPost?.id) }))
  .filter((group) => group.posts.length > 0)
const [firstTheme] = themes

// Further themes get their own front: the group's spotlight as the lead, the rest in a rail beside it
const otherThemes = resolvedGroups.slice(1).map((group) => {
  const lead = group.posts.find((post) => post.id === group.spotlight) ?? group.posts[0]
  return { ...group, lead, rest: group.posts.filter((post) => post.id !== lead?.id) }
}).filter((group) => group.lead)

const featuredSlugs = new Set(featuredGroups.flatMap((group) => group.slugs))
const latestPosts = allWritings.filter((post) => !featuredSlugs.has(post.id)).slice(0, 3)

// The masthead shows today's date like a newspaper; the build date is the fallback without JavaScript
const mastheadDateOptions: Intl.DateTimeFormatOptions = { weekday: "long", year: "numeric", month: "long", day: "numeric" }
const buildDate = new Date().toLocaleDateString("en-us", mastheadDateOptions)
---

<div class="home-page">
  <header class="front-masthead">
    <h2 class="front-masthead-title">Front page</h2>
    <time class="front-date" data-front-date>{buildDate}</time>
  </header>

  <div class="front">
    {featuredPost && (
      <div class="front-lead">
        <Story post={featuredPost} variant="lead" />
      </div>
    )}
    {firstTheme && (
      <section class="front-rail" aria-labelledby="front-rail-label">
        <h2 class="front-rail-label" id="front-rail-label">More on {firstTheme.title}</h2>
        {firstTheme.posts.map((post) => <Story post={post} variant="brief" />)}
      </section>
    )}
  </div>

  {latestPosts.length > 0 && (
    <section class="front-latest" aria-labelledby="front-latest-label">
      <header class="front-masthead">
        <h2 class="front-masthead-title" id="front-latest-label">Latest</h2>
        <a class="front-masthead-link" href="/writings/">All writings →</a>
      </header>
      <div class="front-row">
        {latestPosts.map((post) => <Story post={post} variant="column" />)}
      </div>
    </section>
  )}

  <section class="author-bio" aria-labelledby="author-label">
    <header class="front-masthead">
      <h2 class="front-masthead-title" id="author-label">Author</h2>
      <span class="front-dateline">Helsinki · 60.17°N 24.94°E</span>
    </header>
    <div class="author-bio-top">
      <div class="author-bio-intro">
        <p class="author-name">Arttu</p>
        <p class="from-eu-with-love">🇪🇺 🇫🇮 ❤️ 🏳️‍🌈</p>
        <p class="author-bio-deck">
          Software development consultant writing about software, teams, AI, and the human side of building complex systems.
        </p>
        <div class="author-bio-text">
          <p>
            I love it when people can work as an efficient cross-functional egalitarian team,
            combining multiple perspectives and skillsets to solve complex, systemic problems.
          </p>
          <p>
            I'm fascinated about how teams make sense of complexity, how tools can empower rather than constrain human
            thought, and how we can build software that amplify the lives and work of humans.
          </p>
        </div>
        <a class="section-more author-bio-more" href="/author/">Read more about the author →</a>
      </div>

      <div class="author-bio-aside">
        <div class="sidebar-photo-container">
          <a href="/author/" class="sidebar-photo-link">
            <div class="photo-reveal">
              <div class="photo-reveal-front">
                <Image src={arttu} alt="Arttu Viljakainen" loading="eager" />
              </div>
              <div class="photo-reveal-back">
                <span>This is Arttu, read more about them here →</span>
              </div>
            </div>
          </a>
          <button class="photo-reveal-toggle" type="button" aria-label="Show info">↻</button>
        </div>
      </div>
    </div>
  </section>


  {marginalia.length > 0 && (
    <section class="home-section">
      <header class="front-masthead">
        <h2 class="front-masthead-title">Marginalia</h2>
        <a class="front-masthead-link" href="/marginalia/">All marginalia →</a>
      </header>
      <p class="home-section-desc">Short notes, links, and fragments that stand on their own.</p>
      <ul class="marginalia-list">
        {marginalia.slice(0, 3).map((entry) => (
          <li>
            <MarginaliaEntry entry={entry} compact />
          </li>
        ))}
      </ul>
    </section>
  )}

  {otherThemes.map((theme, index) => (
    <section class="front-theme" aria-labelledby={`theme-${index}`}>
      <header class="front-masthead">
        <h2 class="front-masthead-title" id={`theme-${index}`}>{theme.title}</h2>
      </header>
      <div class:list={["front", { "front--flip": index % 2 === 0 }]}>
        <div class="front-lead">
          <Story post={theme.lead!} variant="lead" />
        </div>
        <div class="front-rail">
          <p class="front-rail-desc">{theme.description}</p>
          {theme.rest.map((post) => <Story post={post} variant="brief" />)}
        </div>
      </div>
    </section>
  ))}

</div>

<style>
    .home-page {
        max-width: 58rem;
        margin: 0 auto;
        padding: 2.5rem 0 4rem;
    }

    /* Until the column has room to spare, keep a gutter so the column rules stay on screen */
    @media (max-width: 1080px) {
        .home-page {
            padding-inline: 1.5rem;
        }
    }

    /* Front page: a newspaper-style grid of stories separated by hairline column rules */
    .front {
        display: grid;
        grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
        padding-top: 1.75rem;
    }

    .front-lead {
        padding-right: 2rem;
    }

    .front-rail {
        padding-left: 2rem;
        border-left: 1px solid var(--color-border);
    }

    .front-rail-label {
        margin: 0 0 1rem;
        padding: 0;
        font-family: var(--font-condensed);
        font-size: 0.85rem;
        font-weight: 400;
        letter-spacing: 0.02em;
        color: var(--color-muted);
    }

    .front-rail > :global(.story + .story) {
        margin-top: 1.25rem;
        padding-top: 1.25rem;
        border-top: 1px solid var(--color-border);
    }

    .front-latest,
    .front-theme {
        margin-top: 3.5rem;
    }

    /* Alternate sides so consecutive fronts don't stack identically */
    .front--flip {
        grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    }

    .front--flip .front-lead {
        order: 2;
        padding: 0 0 0 2rem;
        border-left: 1px solid var(--color-border);
    }

    .front--flip .front-rail {
        order: 1;
        padding: 0 2rem 0 0;
        border-left: 0;
    }

    .front-rail-desc {
        margin: 0 0 1.25rem;
        font-family: var(--font-reading);
        font-size: 1rem;
        font-weight: 300;
        line-height: 1.55;
        color: var(--color-muted);
    }

    /* Equal padding on every column; the negative margin keeps the outer edges aligned */
    .front-row {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        margin: 0 -1.5rem;
        padding-top: 1.5rem;
    }

    .front-row > :global(.story) {
        padding: 0 1.5rem;
        border-left: 1px solid var(--color-border);
    }

    .front-row > :global(.story:first-child) {
        border-left: 0;
    }

    @media (max-width: 800px) {
        .front {
            grid-template-columns: minmax(0, 1fr);
        }

        .front-lead,
        .front--flip .front-lead {
            order: 0;
            padding: 0;
            border-left: 0;
        }

        .front--flip .front-rail {
            order: 0;
            padding: 1.5rem 0 0;
        }

        .front-rail {
            margin-top: 2rem;
            padding: 1.5rem 0 0;
            border-left: 0;
            border-top: 1px solid var(--color-border);
        }

        .front-row {
            grid-template-columns: minmax(0, 1fr);
            margin: 0;
        }

        .front-row > :global(.story) {
            padding: 0;
            border-left: 0;
        }

        .front-row > :global(.story + .story) {
            margin-top: 1.5rem;
            padding-top: 1.5rem;
            border-top: 1px solid var(--color-border);
        }
    }

    .home-section {
        margin: 3.5rem 0 0;
    }

    .home-section-desc {
        margin: 1rem 0 1.5rem;
        max-width: 42rem;
        font-family: var(--font-reading);
        font-size: 1.05rem;
        font-weight: 300;
        line-height: 1.6;
        color: var(--color-muted);
    }

    .marginalia-list {
        list-style: none;
        margin: 0;
        padding: 0;
    }

    /* Notes span the section, but their text wraps at a readable length */
    .marginalia-list li {
        max-width: 50rem;
    }

    .marginalia-list li + li {
        margin-top: 2.25rem;
    }

    .section-more,
    .section-more:visited {
        display: inline-block;
        margin-top: 1.5rem;
        font-family: var(--font-condensed);
        font-size: 0.95rem;
        letter-spacing: 0.02em;
        color: var(--color-link);
        text-decoration: none;
    }

    .section-more:hover {
        text-decoration: underline;
    }

    /* Author section, as in the original design */

    .author-bio-top {
        display: grid;
        grid-template-columns: minmax(0, 1.2fr) minmax(13rem, 0.7fr);
        gap: 2rem;
      align-items: center;
    }

    .author-bio-intro {
        min-width: 0;
    }

    .author-bio-aside {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.85rem;
    }

    .sidebar-photo-container {
        position: relative;
        width: min(16rem, 100%);
        min-height: 21rem;
        padding: 1.4rem 1rem 1.35rem;
        display: grid;
        align-content: end;
        border-radius: 0.65rem;
        background:
          linear-gradient(90deg, transparent 0 63%, color-mix(in srgb, var(--color-blue) 72%, white 28%) 63% 69%, transparent 69% 100%),
          linear-gradient(90deg, transparent 0 12%, color-mix(in srgb, var(--color-yellow) 84%, #e3b233 16%) 12% 40%, transparent 40% 100%),
          linear-gradient(180deg, color-mix(in srgb, var(--color-bg) 90%, #f1e7d8 10%) 0%, color-mix(in srgb, var(--color-bg) 86%, #e5d8c7 14%) 100%);
        box-shadow:
          0 1rem 2.2rem color-mix(in srgb, var(--color-text) 10%, transparent),
          inset 0 0 0 1px color-mix(in srgb, var(--color-text) 8%, transparent);
        overflow: hidden;
        isolation: isolate;
    }

    .sidebar-photo-container::before {
        content: '';
        position: absolute;
      left: 0;
      top: 4.2rem;
      width: 78%;
      height: 3.5rem;
      background: color-mix(in srgb, var(--color-red) 82%, white 18%);
        pointer-events: none;
        z-index: 0;
      opacity: 0.92;
    }

    .sidebar-photo-container::after {
        content: '';
        position: absolute;
      display: none;
        pointer-events: none;
        z-index: 0;
      opacity: 0.9;
    }

    .sidebar-photo-link {
        display: block;
        border-radius: 0.18rem;
        text-decoration: none;
        position: relative;
        z-index: 2;
    }

    .photo-reveal {
        position: relative;
      width: 72%;
      margin: 0 auto 0 12%;
        border-radius: 0.18rem;
        overflow: hidden;
        box-shadow: 0 0.8rem 1.6rem color-mix(in srgb, var(--color-text) 14%, transparent);
        transform: translateY(0.2rem);
    }

    .photo-reveal-front {
        display: block;
    }

    .photo-reveal-front img {
        width: 100%;
        height: auto;
        display: block;
        border: 1px solid color-mix(in srgb, var(--color-text) 12%, transparent);
        border-radius: 0.18rem;
        transition: opacity 0.4s ease, filter 0.4s ease;
        filter: contrast(1.02) saturate(0.94);
    }

    .photo-reveal-back {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding: 1rem;
        background:
          linear-gradient(180deg, color-mix(in srgb, var(--color-bg) 92%, #f1e7d8 8%) 0%, color-mix(in srgb, var(--color-bg) 88%, #e5d8c7 12%) 100%);
        color: color-mix(in srgb, var(--color-text) 92%, #6f5b4d 8%);
        font-family: var(--font-condensed);
        font-size: 0.8rem;
        letter-spacing: 0.03em;
        border-radius: 0.18rem;
        border: 1px solid color-mix(in srgb, var(--color-text) 10%, transparent);
        box-shadow: inset 0 0 0 0.45rem color-mix(in srgb, var(--color-red) 16%, transparent);
        opacity: 0;
        transition: opacity 0.4s ease;
    }

    .photo-reveal-toggle {
      display: flex;
      align-items: center;
      justify-content: center;
      position: absolute;
      right: -0.5rem;
      top: -0.5rem;
      width: 2rem;
      height: 2rem;
        border-radius: 50%;
        border: 1px solid color-mix(in srgb, var(--color-text) 14%, transparent);
        background: color-mix(in srgb, var(--color-bg) 92%, white 8%);
        color: color-mix(in srgb, var(--color-text) 86%, transparent);
      font-size: 1rem;
      cursor: pointer;
      z-index: 2;
      line-height: 1;
        box-shadow: 0 0.2rem 0.6rem color-mix(in srgb, var(--color-text) 10%, transparent);
    }

    .from-eu-with-love {
        font-weight: 200;
        font-size: 0.96rem;
        margin: 0 0 1rem;
    }

    .author-bio {
        margin-top: 3.5rem;
    }

    .author-bio .author-bio-top {
        padding-top: 1.75rem;
    }


    .author-name {
      margin: 0 0 1rem;
      font-family: var(--font-serif);
      font-size: clamp(2.25rem, 5vw, 3.35rem);
      font-weight: 400;
      line-height: 0.95;
      letter-spacing: -0.03em;
    }

    .author-bio-deck {
        max-width: 32rem;
        margin: 0 0 1.25rem;
        font-family: var(--font-condensed);
        font-size: 1rem;
        line-height: 1.5;
        color: var(--color-muted);
    }

    .author-bio-text p {
        max-width: 36rem;
        margin: 0 0 1rem;
        font-family: var(--font-reading);
        font-size: 1.1rem;
        font-weight: 300;
        line-height: 1.65;
    }

    .author-bio .author-bio-more {
        margin-top: 0.25rem;
    }

    .sidebar-photo-link:hover .photo-reveal-front img,
    .photo-reveal.revealed .photo-reveal-front img {
        opacity: 0;
        filter: blur(2px);
    }

    .sidebar-photo-link:hover .photo-reveal-back,
    .photo-reveal.revealed .photo-reveal-back {
        opacity: 1;
    }

    @media (max-width: 800px) {
        .author-bio {
          padding: 1rem 0;
        }

        .author-bio-top {
            grid-template-columns: 1fr;
            gap: 1.5rem;
        }

        .author-bio img {
            max-width: 30ch;
            max-height: 50vh;
        }

        .sidebar-photo-container {
          width: min(30ch, 100%);
          max-width: 30ch;
          min-height: 19rem;
          padding: 1.35rem 0.9rem 1.2rem;
          margin-inline: auto;
        }

        .photo-reveal {
          margin: 0 auto;
        }

        .sidebar-photo-link:hover .photo-reveal-front img {
            opacity: 1;
            filter: none;
        }

        .sidebar-photo-link:hover .photo-reveal-back {
            opacity: 0;
        }

        .photo-reveal-toggle {
          background: var(--color-bg);
        }
    }

    @media (max-width: 720px) {
        .home-page {
            padding: 1.5rem clamp(0.75rem, 2.5vw, 1rem) 3rem;
        }

        .home-section {
            margin-top: 2.75rem;
        }
    }
</style>

<script>
  function initPhotoReveal() {
    const container = document.querySelector<HTMLElement>('.sidebar-photo-container');
    const revealEl = document.querySelector<HTMLElement>('.photo-reveal');
    const toggleBtn = document.querySelector<HTMLButtonElement>('.photo-reveal-toggle');
    if (!container || !revealEl || !toggleBtn) return;
      if (container.dataset.photoRevealInit === 'true') return;

      container.dataset.photoRevealInit = 'true';

    const photoContainer = container;
    const photoReveal = revealEl;
    const photoToggleButton = toggleBtn;

    photoToggleButton.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      photoReveal.classList.toggle('revealed');
    });

    if (window.innerWidth <= 800) {
      let manuallyToggled = false;

      photoToggleButton.addEventListener('click', () => {
        manuallyToggled = !manuallyToggled;
      });

      function checkReveal() {
        if (manuallyToggled) return;
        const rect = photoContainer.getBoundingClientRect();
        const photoMiddle = rect.top + rect.height / 2;
        const screenCenter = window.innerHeight / 2;

        if (photoMiddle < screenCenter) {
          photoReveal.classList.add('revealed');
        } else {
          photoReveal.classList.remove('revealed');
        }
      }

      window.addEventListener('scroll', checkReveal, { passive: true });
      checkReveal();
    }
  }

  document.addEventListener('DOMContentLoaded', initPhotoReveal);
  document.addEventListener('astro:page-load', initPhotoReveal);

  function setFrontDate() {
    const el = document.querySelector('[data-front-date]');
    if (!el) return;
    const today = new Date();
    el.textContent = today.toLocaleDateString('en-us', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });
    el.setAttribute('datetime', today.toISOString().slice(0, 10));
  }

  document.addEventListener('astro:page-load', setFrontDate);
</script>
