---
import { render, type CollectionEntry } from "astro:content"
import FormattedDate from "./FormattedDate.astro"

type Props = {
  entry: CollectionEntry<"marginalia">
  compact?: boolean
}

const { entry, compact = false } = Astro.props
const permalink = `/marginalia/${entry.id}/`
const discussion = entry.data.discussion ?? null
const discussionProvider = discussion?.provider ?? "Discussion"
const isMastodonDiscussion = discussionProvider === "Mastodon"
const discussionLabel = discussionProvider === "Mastodon"
  ? "Discuss on Mastodon"
  : `Discuss on ${discussionProvider}`
const { Content } = await render(entry)

// Notes imported from Mastodon often carry their hashtags in the text already; don't list those twice
const body = (entry.body ?? "").toLowerCase()
const extraTags = (entry.data.tags ?? []).filter((tag) => !body.includes(`#${tag.toLowerCase()}`))
---

<article class:list={["marginalia-entry", compact && "marginalia-entry--compact"]}>
  <header class="marginalia-meta">
    <a class="marginalia-permalink" href={permalink}>
      <FormattedDate date={new Date(entry.data.pubDate)} time />
    </a>
    {entry.data.updatedDate && <span class="marginalia-edited">edited</span>}
  </header>
  <div class="marginalia-content">
    {entry.data.spoilerText && <p class="marginalia-spoiler">{entry.data.spoilerText}</p>}
    <div class="marginalia-body">
      <Content />
    </div>
  </div>
  {entry.data.card && (
    <a class="marginalia-card" href={entry.data.card.url}>
      <div class="marginalia-card-copy">
        <span class="marginalia-card-kicker">Linked</span>
        <span class="marginalia-card-title">{entry.data.card.title}</span>
        {entry.data.card.description && <span class="marginalia-card-description">{entry.data.card.description}</span>}
        {entry.data.card.providerName && <span class="marginalia-card-provider">{entry.data.card.providerName}</span>}
      </div>
    </a>
  )}
  {extraTags.length > 0 && (
    <ul class="marginalia-tags" aria-label="Tags">
      {extraTags.map((tag) => (
        <li>#{tag}</li>
      ))}
    </ul>
  )}
  {discussion && (
    <footer class="marginalia-footer">
      <a
        href={discussion.url}
        target={isMastodonDiscussion ? "_blank" : undefined}
        rel={isMastodonDiscussion ? "noopener noreferrer" : undefined}
      >
        {discussionLabel}
      </a>
    </footer>
  )}
</article>

<style>
  .marginalia-entry {
    display: grid;
    gap: 0.75rem;
  }

  .marginalia-entry--compact {
    gap: 0.6rem;
  }

  .marginalia-meta {
    display: flex;
    gap: 0.5rem;
    align-items: baseline;
    font-family: var(--font-condensed);
    font-size: 0.88rem;
    letter-spacing: 0.02em;
    color: var(--color-muted);
  }

  .marginalia-meta :global(.telemetry-date) {
    font-size: inherit;
  }

  .marginalia-permalink,
  .marginalia-permalink:visited {
    color: inherit;
    text-decoration: none;
  }

  .marginalia-permalink:hover {
    text-decoration: underline;
  }

  .marginalia-edited::before {
    content: "·";
    margin-right: 0.5rem;
    opacity: 0.6;
  }

  .marginalia-spoiler {
    margin: 0;
    font-family: var(--font-condensed);
    color: var(--color-muted);
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .marginalia-content {
    display: grid;
    gap: 0.45rem;
  }

  .marginalia-body {
    font-family: var(--font-reading);
    font-size: 1.1rem;
    font-weight: 300;
    line-height: 1.65;
    color: color-mix(in srgb, var(--color-text) 90%, #463730);
  }

  :global(.dark) .marginalia-body {
    color: var(--color-text);
  }

  :global(.marginalia-body p) {
    margin: 0 0 0.6rem;
  }

  :global(.marginalia-body p:last-child) {
    margin-bottom: 0;
  }

  :global(.marginalia-body a) {
    text-decoration-thickness: 1px;
    text-underline-offset: 0.15em;
    overflow-wrap: anywhere;
  }

  /* Link preview: a thin rule instead of a box */
  .marginalia-card,
  .marginalia-card:visited {
    display: block;
    padding: 0.1rem 0 0.1rem 1rem;
    border-left: 2px solid var(--color-border);
    text-decoration: none;
    color: var(--color-text);
    transition: border-color 0.2s ease;
  }

  .marginalia-card:hover {
    border-left-color: var(--color-link);
  }

  .marginalia-card-copy {
    display: grid;
    gap: 0.2rem;
  }

  .marginalia-card-kicker {
    display: none;
  }

  .marginalia-card-title {
    font-family: var(--font-reading);
    font-size: 1.02rem;
    line-height: 1.35;
    color: var(--color-link);
  }

  .marginalia-card:hover .marginalia-card-title {
    text-decoration: underline;
    text-decoration-thickness: 1px;
  }

  .marginalia-card-description {
    font-family: var(--font-reading);
    font-size: 0.95rem;
    font-weight: 300;
    line-height: 1.5;
    color: var(--color-muted);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .marginalia-card-provider {
    font-family: var(--font-condensed);
    font-size: 0.8rem;
    letter-spacing: 0.03em;
    color: var(--color-muted);
  }

  .marginalia-tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    padding: 0;
    margin: 0;
    font-family: var(--font-condensed);
    font-size: 0.88rem;
    color: var(--color-muted);
  }

  .marginalia-tags li + li {
    margin-top: 0;
  }

  .marginalia-footer {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    font-family: var(--font-condensed);
    font-size: 0.88rem;
    letter-spacing: 0.02em;
  }

  .marginalia-footer a {
    text-decoration: none;
  }

  .marginalia-footer a:hover {
    text-decoration: underline;
  }

  .marginalia-entry--compact .marginalia-tags {
    display: none;
  }

  .marginalia-entry--compact .marginalia-body {
    font-size: 1.05rem;
  }
</style>
