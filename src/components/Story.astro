---
import type { CollectionEntry } from "astro:content";
import StoryArt from "./StoryArt.astro";
import { getTagColor, TAG_COLORS } from "../config/colors";

interface Props {
  post: CollectionEntry<"writings">;
  /** lead: the front page story; column: art above a short story; brief: text only */
  variant?: "lead" | "column" | "brief";
}

const { post, variant = "brief" } = Astro.props;

const href = `/${post.collection}/${post.id}/`;
const date = new Date(post.data.pubDate);
const dateLabel = date.toLocaleDateString("en-us", { year: "numeric", month: "short", day: "numeric" });
const tag = post.data.tags?.[0];
const wordCount = (post.body ?? "").split(/\s+/).filter(Boolean).length;
const readingTime = Math.max(1, Math.round(wordCount / 220));
const HeadingTag = variant === "lead" ? "h2" : "h3";
---

<article class:list={["story", `story--${variant}`]} style={tag && TAG_COLORS[tag] ? `--story-accent: ${TAG_COLORS[tag]}` : undefined}>
  {variant !== "brief" && (
    <a class="story-art-link" href={href} tabindex="-1" aria-hidden="true">
      <StoryArt slug={post.id} tags={post.data.tags} />
    </a>
  )}
  <p class="story-meta">
    {tag && <a class="story-tag" href={`/tags/${tag}/`} style={`--tag: ${getTagColor(tag)}`}>{tag}</a>}
    <time datetime={date.toISOString()}>{dateLabel}</time>
    {variant === "lead" && <span>{readingTime} min read</span>}
  </p>
  <HeadingTag class="story-title"><a href={href}>{post.data.title}</a></HeadingTag>
  {post.data.summary && <p class="story-dek">{post.data.summary}</p>}
</article>

<style>
  .story {
    min-width: 0;
  }

  .story-art-link {
    display: block;
    margin-bottom: 0.9rem;
  }

  .story-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.9rem;
    margin: 0 0 0.45rem;
    font-family: var(--font-condensed);
    font-size: 0.85rem;
    letter-spacing: 0.02em;
    line-height: 1.4;
    color: var(--color-muted);
  }

  .story-tag,
  .story-tag:visited {
    color: var(--color-muted);
    text-decoration: none;
  }

  .story-tag::before {
    content: "";
    display: inline-block;
    width: 0.45rem;
    height: 0.45rem;
    margin-right: 0.4rem;
    border-radius: 50%;
    background: var(--tag);
    vertical-align: 0.05em;
  }

  .story-tag:hover {
    color: var(--color-text);
  }

  .story-title {
    margin: 0;
    padding: 0;
    font-family: var(--font-serif);
    font-size: 1.2rem;
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  .story-title a,
  .story-title a:visited {
    color: var(--color-text);
    text-decoration: none;
  }

  /* The headline leading leaves room for the underline to clear the next line */
  .story-title a:hover,
  .story-title a:focus-visible {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.12em;
    text-decoration-color: var(--story-accent, currentColor);
  }

  .story-dek {
    margin: 0.5rem 0 0;
    font-family: var(--font-reading);
    font-size: 1rem;
    font-weight: 300;
    line-height: 1.55;
    color: color-mix(in srgb, var(--color-text) 80%, transparent);
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .story--lead .story-title {
    font-size: clamp(1.8rem, 3.6vw, 2.5rem);
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .story--lead .story-dek {
    margin-top: 0.8rem;
    font-size: 1.12rem;
    line-height: 1.6;
    -webkit-line-clamp: unset;
  }

  .story--lead .story-art-link {
    margin-bottom: 1.1rem;
  }

  .story--lead :global(.story-art) {
    aspect-ratio: 2 / 1;
  }

  .story--brief .story-dek {
    -webkit-line-clamp: 3;
  }

  /* Stacked on phones, the pictures become low strips so the stories stay close together */
  @media (max-width: 800px) {
    .story--column :global(.story-art) {
      aspect-ratio: 3 / 1;
    }
  }
</style>
