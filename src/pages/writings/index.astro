---
import "../../styles/global.css"
import BaseLayout from "../../layouts/BaseLayout.astro"
import WritingListItem from "../../components/WritingListItem.astro"
import { getCollection } from "astro:content"
const writings = (await getCollection("writings")).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
const title = "Writings"
const description = "Articles on software development, team leadership, human-computer interaction, and agile processes by Arttu V."

// Group by publication year, newest first (writings are already sorted)
const years: { year: number; posts: typeof writings }[] = []
for (const post of writings) {
    const year = new Date(post.data.pubDate).getFullYear()
    const group = years.at(-1)
    if (group?.year === year) {
        group.posts.push(post)
    } else {
        years.push({ year, posts: [post] })
    }
}
const yearSpan = `${years.at(-1)?.year}–${years[0]?.year}`
---
<BaseLayout title={title} description={description}>
  <div class="page-column">
    <header class="front-masthead">
      <span class="front-masthead-title">Archive</span>
      <span class="front-dateline">{writings.length} essays · {yearSpan}</span>
    </header>
    <header class="page-header">
      <h1 class="page-title">{title}</h1>
      <p class="page-intro">
        Essays and articles on software, systems, research, and people. Short texts and quick takes can be found in <a href="/marginalia/">marginalia</a>. Comments are on Mastodon.
      </p>
    </header>

    {years.map(({ year, posts }) => (
      <section class="list-section" aria-labelledby={`year-${year}`}>
        <h2 class="list-section-label" id={`year-${year}`}>{year}</h2>
        <ol class="writing-list">
          {posts.map((post) => <WritingListItem post={post} />)}
        </ol>
      </section>
    ))}
  </div>
</BaseLayout>
