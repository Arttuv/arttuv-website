---
import { getCollection, type CollectionEntry } from "astro:content"
import BaseLayout from "../../layouts/BaseLayout.astro"
import MarginaliaEntry from "../../components/MarginaliaEntry.astro"

export async function getStaticPaths() {
  const entries = await getCollection("marginalia")
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }))
}

type Props = {
  entry: CollectionEntry<"marginalia">
}

const { entry } = Astro.props
const title = entry.data.card?.title ?? `Marginalia · ${entry.data.pubDate.toISOString().slice(0, 10)}`
const description = entry.data.card?.description ?? entry.data.spoilerText ?? "Short-form note by Arttu Viljakainen."
---

<BaseLayout title={title} description={description}>
  <div class="page-column">
    <header class="front-masthead marginalia-masthead">
      <a class="front-masthead-link" href="/marginalia/">← Marginalia</a>
      <span class="front-dateline">Note</span>
    </header>
    <MarginaliaEntry entry={entry} />
  </div>
</BaseLayout>

<style>
  .marginalia-masthead {
    margin-bottom: 1.75rem;
  }
</style>
