---
import BaseLayout from "../../layouts/BaseLayout.astro"
import MarginaliaEntry from "../../components/MarginaliaEntry.astro"
import { getCollection } from "astro:content"

const marginalia = (await getCollection("marginalia")).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
const title = "Marginalia"
const description = "Short-form notes and links by Arttu V."
---

<BaseLayout title={title} description={description}>
  <div class="page-column">
    <header class="front-masthead">
      <span class="front-masthead-title">Notes</span>
      <span class="front-dateline">{marginalia.length} {marginalia.length === 1 ? "note" : "notes"}</span>
    </header>
    <header class="page-header">
      <h1 class="page-title">{title}</h1>
      <p class="page-intro">
        Short notes and links, mostly cross-posted from Mastodon. Longer texts are in <a href="/writings/">writings</a>. Comments are on Mastodon.
      </p>
    </header>
    <div class="marginalia-list">
      {marginalia.map((entry) => (
        <MarginaliaEntry entry={entry} />
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .marginalia-list {
    display: grid;
    gap: 2.75rem;
  }
</style>
