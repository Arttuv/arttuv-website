---
import BaseLayout from "../../layouts/BaseLayout.astro"
import MarginaliaEntry from "../../components/MarginaliaEntry.astro"
import { getCollection } from "astro:content"

const marginalia = (await getCollection("marginalia")).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
const title = "Marginalia"
const description = "Short-form notes and links by Arttu Viljakainen."
---

<BaseLayout title={title} description={description}>
  <div class="page-column">
    <header class="page-header">
      <h1 class="page-title">{title}</h1>
      <p class="page-intro">
        Fragments, links, and passing observations. These are lighter than <a href="/writings/">writings</a>, but still worth keeping. Discussion, if any, continues on the linked Mastodon post.
      </p>
    </header>
    <div class="marginalia-list">
      {marginalia.map((entry) => (
        <MarginaliaEntry entry={entry} />
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .marginalia-list {
    display: grid;
    gap: 2.75rem;
  }
</style>
