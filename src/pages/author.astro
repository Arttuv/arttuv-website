---
import "../styles/global.css"
import { Image } from "astro:assets"
import BaseLayout from "../layouts/BaseLayout.astro"
import BauhausArt from "../components/BauhausArt.astro"
import arttu from "../images/arttuv-bw.jpeg"
const title = "Arttu Viljakainen"
const description = "Arttu Viljakainen is a software development consultant from Finland."
---

<BaseLayout title={title} description={description}>
  <div class="author-page">

    <header class="front-masthead">
      <span class="front-masthead-title">Author</span>
      <span class="front-dateline">Helsinki · 60.17°N 24.94°E</span>
    </header>

    <div class="author-hero">
      <div class="author-hero-text">
        <h1>Arttu Viljakainen</h1>
        <p class="author-role">Software development consultant</p>
        <p>
          I'm a generalist software developer interested in teamwork, research and complex systems. Generalist means that I'm usually
          somewhere in the middle of technology and people and I'm interested in both.
          
          With over 15 years of experience, I always try to have a broad and systemic view over what we are doing, and how it all connects together.
        </p>
        <p>
          My focus is on hands-on software development, but I believe the performance of a team matters
          more than any individual's skills. I'm passionate about studying and improving teamwork and
          shared leadership, helping teams work effectively together without relying on command and control.
        </p>
        <p>
          Organization and its culture are essential for teamwork. It's the environment where the teams are born and live and affects
          what kind of teams there can be and what is the limit of what they can achieve. I want to be part 
          of building a better environments for software development.
        </p>
        <p>
          I find meaning in doing work that matters. I love environments where teams have high autonomy
          and can self-organise. Titles don't define what you can do. What matters is making good things happen.
        </p>
        <p>
          Humans as collaborative digital tool makers is an interesting viewpoint.
        </p>
        <p class="author-links">
          <a href="https://mastodon.social/@arttuv" target="_blank" rel="noopener noreferrer">Mastodon</a>
          <a href="https://www.linkedin.com/in/arttu-viljakainen/">LinkedIn</a>
        </p>
        <p>
          My very occasional photos can be found on <a href="https://photos.arttuv.com" target="_blank" rel="noopener noreferrer">photos.arttuv.com</a>.
        </p>
      </div>
      <figure class="author-hero-photo">
        <Image src={arttu} alt="Arttu Viljakainen" loading="eager" />
        <figcaption>Arttu, Helsinki</figcaption>
      </figure>
    </div>

    <section class="author-section" aria-labelledby="skills-heading">
    <header class="front-masthead">
      <h2 class="front-masthead-title" id="skills-heading">Skills &amp; education</h2>
    </header>
    <div class="author-skills">
      <div class="skill-section skill-section--dev">
        <p class="skill-label">Technical</p>
        <ul>
          <li>JVM: Java, Kotlin (10+ years)</li>
          <li>Web: React, Node, TypeScript, HTML/CSS</li>
          <li>Databases: PostgreSQL, MariaDB, ElasticSearch</li>
          <li>Cloud: Kubernetes, AWS, containers</li>
          <li>.NET, GoLang, Android, Jetpack Compose, Delphi</li>
        </ul>
        <p class="skill-note">Cloud native systems, Android tablets, desktop applications. Public sector, defence, and commercial.</p>
      </div>
      <div class="skill-section skill-section--hci">
        <p class="skill-label">Leadership &amp; process</p>
        <ul>
          <li>Advanced Certified ScrumMaster (A-CSM)</li>
          <li>Certified ScrumMaster (CSM)</li>
          <li>Certified Scrum Product Owner (CSPO)</li>
          <li>Certified SAFe 5 Practitioner</li>
          <li>Reaktor Team Builder Academy (2021)</li>
          <li>Reaktor Leading Teams (2021)</li>
        </ul>
        <p class="skill-note">Certifications reflect experience, not endorsement. I prefer letting teams find their own way of working.</p>
      </div>
      <div class="skill-section skill-section--research">
        <p class="skill-label">Education</p>
        <ul>
          <li><strong>MSc</strong>, University of Eastern Finland (2012)</li>
          <li>Major: Computer Science, software engineering</li>
          <li>Minors: psychology, cognitive science, business economics</li>
          <li>PhD student at Tampere University (on hold)</li>
        </ul>
        <ul>
          <li>Finnish (native), English (advanced), Swedish (basics)</li>
        </ul>
      </div>
    </div>
    </section>

    <section class="author-section" aria-labelledby="work-heading">
    <header class="front-masthead">
      <h2 class="front-masthead-title" id="work-heading">Work history</h2>
      <span class="front-dateline">2008 – now</span>
    </header>

    <div class="cv-listing">
      <div class="cv-item-time"><span>Now</span></div>
      <div class="cv-item-content">
        <p>Full time at Reaktor, studying teamwork on the side.</p>
      </div>

      <div class="cv-item-time"><span>2019</span></div>
      <div class="cv-item-content">
        <p class="cv-company">Reaktor <span class="cv-current">→ current</span></p>
        <p>Software consultancy. My roles have varied from senior full-stack developer to team lead, scrum master, and agile coach.</p>
        <p>I have gained experience on telecom, aero, public sector and industrial domains.</p>
      </div>
      <div class="cv-item-time"><span>2014</span></div>
      <div class="cv-item-content">
        <p class="cv-company">Insta DefSec Oy</p>
        <p>Senior software engineer, team lead &amp; scrum master, usability specialist.</p>
        <p>A deep-dive in defense domain, and experience in building tools for professionals; skills that are applicable in multiple domains.</p>
      </div>

      <div class="cv-item-time"><span>2013</span></div>
      <div class="cv-item-content">
        <p class="cv-company">Suonentieto Oy</p>
        <p>Delphi application developer.</p>
        <p>Worked on various desktop applications, focusing on user interface and experience improvements.</p>
      </div>

      <div class="cv-item-time"><span>2010</span></div>
      <div class="cv-item-content">
        <p class="cv-company">CGI / Logica</p>
        <p>Java and XSLT transformations in a large SAP PI integration project.</p>
        <p>Gained experience in enterprise integration and large-scale software development.</p>
      </div>

      <div class="cv-item-time"><span>2008</span></div>
      <div class="cv-item-content">
        <p class="cv-company">European Forest Institute</p>
        <p>Java developer trainee, summer 2008.</p>
        <p>Worked on a desktop application for sustainability impact assessment focusing on improving the user experience and XML processing.</p>
      </div>
    </div>
    </section>

    <section class="author-section" aria-labelledby="origin-heading">
    <header class="front-masthead">
      <h2 class="front-masthead-title" id="origin-heading">Beginnings</h2>
      <span class="front-dateline">1999</span>
    </header>
    <div class="author-origin">
      <p>
        I started programming around 1999 in QBasic, and then in Turbo Pascal. No internet, just library books and trial and error —
        building ASCII games with nothing but <code>IF-ELSE</code> technology. I loved it, best years of computing for me. I got so addicted in coding that it somewhat displaced gaming for me.
      </p>
      <p>
        That spark never went away. I never really thought of doing anything else for a living.
      </p>
    </div>
    </section>

    <BauhausArt />

  </div>
</BaseLayout>

<style>
    /* Same 58rem column and section bars as the home page */
    .author-page {
        max-width: 58rem;
        margin: 0 auto;
        padding: 2.5rem 0 1rem;
    }

    /* Hero: text at a readable measure, the photo as a captioned picture beside it */
    .author-hero {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 15rem;
        gap: 3rem;
        align-items: start;
        padding-top: 1.75rem;
    }

    .author-hero-text {
        min-width: 0;
        max-width: 40rem;
    }

    .author-hero-text h1 {
        margin-top: 0;
        margin-bottom: 0.25rem;
    }

    .author-hero-text p {
        font-size: 1.02rem;
        line-height: 1.72;
        margin-bottom: 1rem;
    }

    .author-hero-text .author-role {
        font-family: var(--font-condensed);
        font-size: 0.9rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--color-muted);
        margin-bottom: 1.25rem;
    }

    .author-links {
        display: flex;
        gap: 1.5rem;
        flex-wrap: wrap;
        font-family: var(--font-condensed);
        font-size: 1rem;
    }

    .author-links a {
        text-decoration: none;
    }

    .author-links a:hover {
        text-decoration: underline;
    }

    .author-hero-photo {
        margin: 0.5rem 0 0;
    }

    .author-hero-photo img {
        width: 100%;
        height: auto;
        display: block;
        border-radius: 0.25rem;
    }

    .author-hero-photo figcaption {
        margin-top: 0.5rem;
        padding-top: 0.45rem;
        border-top: 1px solid var(--color-border);
        font-family: var(--font-condensed);
        font-size: 0.82rem;
        letter-spacing: 0.02em;
        color: var(--color-muted);
    }

    .author-section {
        margin-top: 3.5rem;
    }

    /* Skills: three columns separated by hairline rules, each marked with its colour */
    .author-skills {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        margin: 0 -1.5rem;
        padding-top: 1.5rem;
    }

    .skill-section {
        --skill-color: var(--color-red);
        padding: 0 1.5rem;
        border-left: 1px solid var(--color-border);
    }

    .skill-section:first-child {
        border-left: 0;
    }

    .skill-section--dev      { --skill-color: var(--color-red); }
    .skill-section--hci      { --skill-color: var(--color-blue); }
    .skill-section--research { --skill-color: var(--color-yellow); }

    .skill-label {
        font-family: var(--font-condensed);
        font-size: 0.9rem;
        font-weight: 600;
        letter-spacing: 0.02em;
        color: var(--color-text);
        margin: 0 0 0.75rem;
    }

    .skill-label::before {
        content: "";
        display: inline-block;
        width: 0.5rem;
        height: 0.5rem;
        margin-right: 0.5rem;
        border-radius: 50%;
        background: var(--skill-color);
        vertical-align: 0.05em;
    }

    .skill-section ul {
        padding-left: 1rem;
        margin: 0 0 0.75rem;
        font-size: 0.95rem;
        line-height: 1.55;
    }

    .skill-section li + li {
        margin-top: 0.2rem;
    }

    .skill-note {
        font-family: var(--font-condensed);
        font-size: 0.88rem;
        color: var(--color-muted);
        line-height: 1.5;
        margin: 0;
    }

    /* CV timeline */
    .cv-listing {
        display: grid;
        grid-template-columns: 4.5rem 1fr;
        padding-top: 1.5rem;
    }

    .cv-item-time {
        text-align: right;
        padding-right: 1rem;
        border-right: 1px solid var(--color-border);
        font-family: var(--font-condensed);
        font-size: 0.9rem;
        color: var(--color-muted);
        padding-top: 0.2rem;
        position: relative;
    }

    .cv-item-time span::after {
        content: '';
        position: absolute;
        right: -0.45rem;
        top: 0.45rem;
        width: 0.8rem;
        height: 0.8rem;
        border-radius: 50%;
        background-color: var(--color-red);
        border: 2px solid var(--color-bg);
    }

    .cv-item-content {
        max-width: 44rem;
        padding: 0 0 1.25rem 1.25rem;
        font-size: 1rem;
        line-height: 1.66;
    }

    .cv-item-content p {
        margin: 0 0 0.3rem;
    }

    .cv-company {
        font-weight: 600;
        font-family: var(--font-condensed);
        font-size: 1rem;
    }

    .cv-current {
        font-weight: 400;
        color: var(--color-red);
        font-size: 0.9rem;
    }

    /* Origin story */
    .author-origin {
        max-width: 40rem;
        padding-top: 1.5rem;
        font-size: 1.02rem;
        line-height: 1.72;
    }

    .author-origin p {
        margin-bottom: 0.75rem;
    }

    @media (max-width: 1080px) {
        .author-page {
            padding-inline: 1.5rem;
        }
    }

    @media (max-width: 800px) {
        .author-page {
            padding: 1.5rem clamp(0.75rem, 2.5vw, 1rem) 1rem;
        }

        .author-hero {
            grid-template-columns: minmax(0, 1fr);
            gap: 1.5rem;
        }

        .author-hero-photo {
            order: -1;
            max-width: 14rem;
            margin: 0;
        }

        .author-skills {
            grid-template-columns: minmax(0, 1fr);
            margin: 0;
        }

        .skill-section {
            padding: 0;
            border-left: 0;
        }

        .skill-section + .skill-section {
            margin-top: 1.5rem;
            padding-top: 1.5rem;
            border-top: 1px solid var(--color-border);
        }
    }
</style>
