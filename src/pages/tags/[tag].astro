---
import BaseLayout from "../../layouts/BaseLayout.astro"
import WritingListItem from "../../components/WritingListItem.astro"
import { getTagColor } from "../../config/colors"
import { getCollection } from "astro:content"

export async function getStaticPaths() {
  const allPosts = (await getCollection("writings")).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  const uniqueTags = [...new Set(allPosts.map((post) => post.data.tags).flat())]
  return uniqueTags.map((tag) => {
    const filteredPosts = allPosts.filter((post) => post.data.tags.includes(tag))
    return {
      params: { tag },
      props: { posts: filteredPosts },
    }
  })
}

const { tag } = Astro.params
const { posts } = Astro.props
---
<BaseLayout title={`#${tag}`} description={`All posts tagged with ${tag}`} robots="noindex,follow">
  <div class="page-column">
    <header class="page-header">
      <h1 class="page-title"><span class="tag-hash" style={`color: ${getTagColor(tag ?? "")}`}>#</span>{tag}</h1>
      <p class="page-intro">
        {posts.length} {posts.length === 1 ? "writing" : "writings"} tagged {tag}. See <a href="/writings/">all writings</a> or <a href="/tags/">all tags</a>.
      </p>
    </header>
    <ul class="writing-list">
      {posts.map((post) => <WritingListItem post={post} showYear />)}
    </ul>
  </div>
</BaseLayout>

<style>
  .tag-hash {
    margin-right: 0.04em;
  }
</style>
