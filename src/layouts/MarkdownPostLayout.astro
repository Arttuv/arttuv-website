---
import BaseLayout from "./BaseLayout.astro"
import FormattedDate from "../components/FormattedDate.astro"
import DiscussionLink from "../components/DiscussionLink.astro"
import BauhausBlock from "../components/BauhausBlock.astro"
import ReadingProgress from "../components/ReadingProgress.astro"
import { getCollection, render, type CollectionEntry } from "astro:content"
import { getTagColor, getCardColor } from "../config/colors"
import BauhausDivider from "../components/BauhausDivider.astro"
import TableOfContents from "../components/TableOfContents.astro"
type Props = CollectionEntry<"writings">;
const post = Astro.props

const tagColor = getCardColor(post.data.tags);

// Reading time estimate
const { remarkPluginFrontmatter, headings } = await render(post);
const body = post.body ?? '';
const wordCount = body.split(/\s+/).filter(Boolean).length;
const readingTime = Math.max(1, Math.round(wordCount / 220));
const relatedPosts = (await getCollection("writings", (entry) => {
    if (entry.id === post.id) {
        return false;
    }

    const entryTags = entry.data.tags ?? [];
    const postTags = post.data.tags ?? [];
    return entryTags.some((tag) => postTags.includes(tag));
}))
    .sort((left, right) => {
        const leftSharedTags = (left.data.tags ?? []).filter((tag) => (post.data.tags ?? []).includes(tag)).length;
        const rightSharedTags = (right.data.tags ?? []).filter((tag) => (post.data.tags ?? []).includes(tag)).length;

        if (leftSharedTags !== rightSharedTags) {
            return rightSharedTags - leftSharedTags;
        }

        return right.data.pubDate.valueOf() - left.data.pubDate.valueOf();
    })
    .slice(0, 3);
---
<BaseLayout title={post.data.title} description={post.data.summary} ogType="article" publishedDate={new Date(post.data.pubDate).toISOString()} tags={post.data.tags}>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": post.data.title,
    "description": post.data.summary,
    "datePublished": new Date(post.data.pubDate).toISOString(),
    "author": {
      "@type": "Person",
      "name": "Arttu V.",
      "url": "https://arttuv.com/author"
    },
    "publisher": {
      "@type": "Person",
      "name": "Arttu V."
    },
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": `https://arttuv.com/writings/${post.id}/`
    },
    "wordCount": wordCount,
    ...(post.data.tags ? { "keywords": post.data.tags.join(", ") } : {})
  })} />
  <ReadingProgress tagColor={tagColor} />
  <article class="blog-post" style={`--tag-color: ${tagColor}`}>
    {post.data.tags && post.data.tags.length > 0 && (
      <div class="category">
        {post.data.tags.map((tag) => (
                                    <span><a href={`/tags/${tag}/`} class="card-tag" style={`color: ${getTagColor(tag)}; --tag-pill-color: ${getTagColor(tag)}`}>#{tag}</a></span>
        ))}
      </div>
    )}
    <BauhausBlock slug={post.id} tags={post.data.tags} direction="horizontal" />
    <h1>{post.data.title}</h1>
    <div class="post-meta">
      <FormattedDate date={new Date(post.data.pubDate)} />
      <span class="meta-separator">·</span>
      <span class="reading-time">{readingTime} min read</span>
    </div>
    {post.data.summary && (
      <div class="abstract">
        <span class="abstract-label">Abstract</span>
        <p>{post.data.summary}</p>
      </div>
    )}
    {post.data.updates && post.data.updates.length > 0 && (
      <div class="post-updates">
        <span class="post-updates-label">Updates</span>
        <ul>
          {post.data.updates.map((update) => (
            <li><strong>{update.date}</strong> {update.text}</li>
          ))}
        </ul>
      </div>
    )}
    <hr />
    <div class="post-body">
      <TableOfContents headings={headings} slug={post.id} tags={post.data.tags} />
      <aside class="post-details" aria-label="Article details">
        <dl>
          <div class="post-details-row">
            <dt>Published</dt>
            <dd><FormattedDate date={new Date(post.data.pubDate)} /></dd>
          </div>
          <div class="post-details-row">
            <dt>Reading time</dt>
            <dd>{readingTime} min</dd>
          </div>
          {post.data.tags && post.data.tags.length > 0 && (
            <div class="post-details-row">
              <dt>Topics</dt>
              <dd>
                <ul class="post-details-tags">
                  {post.data.tags.map((tag) => (
                    <li><a href={`/tags/${tag}/`} style={`--tag: ${getTagColor(tag)}`}>{tag}</a></li>
                  ))}
                </ul>
              </dd>
            </div>
          )}
          {post.data.discussion && (
            <div class="post-details-row">
              <dt>Discuss</dt>
              <dd><a href={post.data.discussion.url} target="_blank" rel="noopener noreferrer">{post.data.discussion.provider ?? "Discussion"} ↗</a></dd>
            </div>
          )}
        </dl>
      </aside>
      <slot />
    </div>
    <BauhausDivider seed={post.id} height="20px" spacing="2.5rem" />
    <div class="writing-ending">•</div>
        {post.data.discussion &&
            <DiscussionLink discussion={post.data.discussion} />}
        {relatedPosts.length > 0 && (
            <aside class="related-posts" aria-labelledby="related-posts-heading">
                <h2 id="related-posts-heading">Read More</h2>
                <ul class="related-posts-list">
                    {relatedPosts.map((relatedPost) => (
                        <li>
                            <a href={`/${relatedPost.collection}/${relatedPost.id}/`}>{relatedPost.data.title}</a>
                            <FormattedDate date={new Date(relatedPost.data.pubDate)} />
                        </li>
                    ))}
                </ul>
            </aside>
        )}
  </article>
</BaseLayout>

<style is:global>
    /* Roughly 80-85 characters per line at the body size below */
    .blog-post {
        max-width: 42rem;
        margin: 3rem auto 4rem;
        color: color-mix(in srgb, var(--color-text) 90%, #463730);
    }

    .dark .blog-post {
        color: var(--color-text);
    }

    .blog-post pre {
        overflow: auto;
    }

    .blog-post .post-body {
        position: relative;
        font-family: var(--font-reading);
        font-size: 1.1rem;
        line-height: 1.7;
        font-weight: 300;
        text-wrap: pretty;
        hanging-punctuation: first;
    }

    .blog-post strong {
        font-weight: 600;
    }

    .blog-post .related-posts {
        margin-top: 2.5rem;
        padding-top: 1rem;
        border-top: 1px solid color-mix(in srgb, var(--tag-color, #212121) 22%, transparent);
    }

    .blog-post .related-posts h2 {
        margin-top: 0;
        margin-bottom: 0.75rem;
        font-family: var(--font-condensed);
        font-size: 0.85rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--color-muted);
    }

    .blog-post .related-posts-list {
        list-style: none;
        padding: 0;
        margin: 0;
        display: grid;
        gap: 0.6rem;
        font-family: var(--font-reading);
        font-size: 1.05rem;
    }

    .blog-post .related-posts-list li {
        display: flex;
        flex-wrap: wrap;
        gap: 0.35rem 0.75rem;
        align-items: baseline;
    }

    .blog-post .related-posts-list a {
        text-decoration: none;
    }

    .blog-post .related-posts-list a:hover {
        text-decoration: underline;
    }

    .blog-post .related-posts-list time {
        margin: 0;
        font-size: 0.8rem;
    }

    /* One serif voice for the whole article: Newsreader for headings as well as body */
    .blog-post h1, .blog-post h2, .blog-post h3, .blog-post h4, .blog-post h5 {
        font-family: var(--font-reading);
        padding-left: 0;
        margin-left: 0;
        padding-bottom: 0;
        margin-top: 3rem;
        margin-bottom: 0.75rem;
        scroll-margin-top: 6rem;
        text-wrap: balance;
    }

    .blog-post h2 {
        font-size: 1.6rem;
        font-weight: 600;
        line-height: 1.2;
        letter-spacing: -0.005em;
    }

    .blog-post h3 {
        font-size: 1.3rem;
        font-weight: 400;
        font-style: italic;
        line-height: 1.3;
        margin-top: 2.25rem;
    }

    .blog-post h1:first-of-type {
        font-size: clamp(2.4rem, 6vw, 3.5rem);
        text-align: left;
        margin-top: 1.25rem;
        margin-bottom: 0.9rem;
        font-weight: 400;
        line-height: 1.06;
        letter-spacing: -0.015em;
    }

    .blog-post .category {
        margin: 1rem 0 0.5rem;
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        align-items: center;
    }

    .blog-post .category span {
        display: inline-flex;
    }

    .blog-post .category .card-tag {
        font-size: 0.85rem;
        margin-right: 0;
    }

    /* Post meta: date + reading time */
    .blog-post .post-meta {
        display: flex;
        align-items: baseline;
        gap: 0.5rem;
        margin-bottom: 2rem;
        font-family: var(--font-condensed);
        font-size: 0.9rem;
        letter-spacing: 0.02em;
        color: var(--color-muted);
    }

    .blog-post .meta-separator {
        opacity: 0.6;
    }

    /* Override the site-wide monospace date inside articles */
    .blog-post time.telemetry-date {
        display: inline;
        font-family: var(--font-condensed);
        font-size: inherit;
        letter-spacing: 0.02em;
        text-transform: none;
        color: var(--color-muted);
        margin: 0;
    }

    .blog-post .related-posts-list time.telemetry-date {
        font-size: 0.8rem;
    }

    /* Abstract / Summary: the one framed element at the top */
    .blog-post .abstract {
        margin: 0 0 2rem;
        padding: 1.1rem 1.3rem;
        background: color-mix(in srgb, var(--tag-color, #212121) 5%, transparent);
        border-left: 3px solid var(--tag-color, #212121);
        border-radius: 0 6px 6px 0;
    }

    .dark .blog-post .abstract {
        background: color-mix(in srgb, var(--tag-color, #F5F5F5) 8%, transparent);
    }

    .blog-post .abstract-label,
    .blog-post .post-updates-label {
        display: block;
        font-family: var(--font-condensed);
        font-size: 0.78rem;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        font-weight: 600;
        margin-bottom: 0.4rem;
    }

    .blog-post .abstract-label {
        color: var(--tag-color, #212121);
    }

    .dark .blog-post .abstract-label {
        color: color-mix(in srgb, var(--tag-color, #F5F5F5) 75%, white);
    }

    .blog-post .abstract p {
        margin: 0;
        font-family: var(--font-reading);
        font-size: 1.05rem;
        font-weight: 300;
        line-height: 1.6;
    }

    /* Post Updates */
    .blog-post .post-updates {
        margin: 0 0 2rem;
        padding: 0.9rem 1.3rem;
        border-left: 3px solid var(--color-border);
        font-size: 0.95rem;
    }

    .blog-post .post-updates-label {
        color: var(--color-muted);
    }

    .blog-post .post-updates ul {
        margin: 0;
        padding-left: 1.2rem;
        line-height: 1.55;
        color: var(--color-muted);
    }

    .blog-post .post-updates li {
        margin-bottom: 0.4rem;
    }

    .blog-post .post-updates li:last-child {
        margin-bottom: 0;
    }

    .blog-post hr:not(.content-ending-line) {
        border: none;
        border-top: 1px solid var(--tag-color, #212121);
        opacity: 0.25;
        margin: 0 0 2rem;
    }

    .blog-post .post-body hr {
        width: 4rem;
        margin: 2.5rem auto;
    }

    .blog-post ul {
        margin-left: 0;
        margin-bottom: 1.5rem;
        padding-left: 1.4rem;
    }

    .blog-post ul li {
        margin-bottom: 0.5rem;
    }

    .blog-post p {
        margin-bottom: 1.3rem;
        max-width: 100%;
    }

    .blog-post .post-body p {
        line-height: inherit;
    }

    .blog-post .post-body > p:first-of-type::first-letter {
        float: left;
        font-family: var(--font-reading);
        font-size: 3.3em;
        line-height: 0.8;
        padding-right: 0.08em;
        padding-top: 0.08em;
        font-weight: 600;
        color: var(--tag-color, #212121);
    }

    .dark .blog-post .post-body > p:first-of-type::first-letter {
        color: var(--tag-color, #F5F5F5);
    }

    .blog-post .post-body a,
    .blog-post .related-posts-list a {
        color: var(--color-link);
        text-decoration-thickness: 1px;
        text-underline-offset: 0.15em;
        text-decoration-color: color-mix(in srgb, var(--color-link) 45%, transparent);
    }

    .blog-post .post-body a:hover,
    .blog-post .related-posts-list a:hover {
        text-decoration-color: currentColor;
    }

    /* Image captions from markdown title attribute */
    .blog-post img {
        object-fit: contain;
        height: inherit;
        width: 100%;
        border: 1px solid var(--color-border);
        border-radius: 4px;
        margin: 0 auto;
        display: block;
    }

    .blog-post img + em,
    .blog-post p:has(> img) + p > em:only-child {
        display: block;
        text-align: center;
        font-size: 0.85rem;
        color: var(--color-muted);
        margin-top: 0.5rem;
        margin-bottom: 1.5rem;
        font-family: var(--font-condensed);
        font-style: normal;
    }

    .content-ending-line {
        margin-top: 3rem;
        margin-bottom: 2rem;
    }

    .writing-ending {
        text-align: center;
        font-size: 1.5em;
        color: var(--tag-color, #000);
        margin: 1rem 0;
    }

    .dark .writing-ending {
        color: var(--tag-color, #F5F5F5);
    }

    /* Quotes: a quiet indent with a thin rule, no box */
    .blog-post blockquote {
        margin: 2rem 0;
        padding: 0.1rem 0 0.1rem 1.25rem;
        border-left: 2px solid color-mix(in srgb, var(--tag-color, #212121) 70%, transparent);
    }

    .blog-post blockquote p {
        margin: 0 0 0.6rem;
        font-style: italic;
        line-height: 1.62;
        color: color-mix(in srgb, var(--color-text) 80%, transparent);
    }

    .blog-post blockquote p:last-child {
        margin-bottom: 0;
    }

    .blog-post blockquote em {
        font-style: normal;
    }

    .blog-post ol {
        margin-bottom: 1.5rem;
        padding-left: 1.5rem;
    }

    .blog-post li {
        line-height: 1.6;
    }

    /* Article details: a quiet label/value column in the right margin on wide screens */
    .blog-post .post-details {
        display: none;
    }

    @media (min-width: 1240px) {
        .blog-post .post-meta {
            display: none;
        }

        .blog-post .post-details {
            display: block;
            position: absolute;
            top: 0;
            bottom: 0;
            left: calc(100% + 3.5rem);
            width: 13rem;
        }

        .blog-post .post-details dl {
            position: sticky;
            top: 7rem;
            margin: 0;
            font-family: var(--font-condensed);
            font-size: 0.88rem;
            font-weight: 400;
            line-height: 1.4;
            border-bottom: 1px solid var(--color-border);
        }

        .blog-post .post-details-row {
            display: grid;
            grid-template-columns: 5.75rem minmax(0, 1fr);
            gap: 0.5rem;
            padding: 0.55rem 0;
            border-top: 1px solid var(--color-border);
        }

        .blog-post .post-details dt {
            color: var(--color-text);
        }

        .blog-post .post-details dd {
            margin: 0;
            color: var(--color-muted);
        }

        .blog-post .post-details time.telemetry-date {
            font-size: inherit;
            letter-spacing: 0;
        }

        .blog-post .post-details-tags {
            list-style: none;
            margin: 0;
            padding: 0;
        }

        .blog-post .post-details-tags li {
            margin: 0 0 0.3rem;
            line-height: 1.4;
        }

        .blog-post .post-details-tags li:last-child {
            margin-bottom: 0;
        }

        .blog-post .post-details a {
            color: var(--color-muted);
            text-decoration: none;
        }

        .blog-post .post-details-tags a::before {
            content: "";
            display: inline-block;
            width: 0.45rem;
            height: 0.45rem;
            margin-right: 0.45rem;
            border-radius: 50%;
            background: var(--tag);
            vertical-align: 0.05em;
        }

        .blog-post .post-details a:hover {
            color: var(--color-text);
            text-decoration: underline;
            text-underline-offset: 0.15em;
        }
    }

    @media (max-width: 720px) {
        .blog-post {
            margin-top: 2rem;
            box-sizing: border-box;
            padding-inline: clamp(0.75rem, 2.5vw, 1rem);
        }

        .blog-post .post-body {
            font-size: 1.07rem;
        }

        .blog-post .post-body > h2 {
            margin-top: 2.25rem;
        }
    }

    @media (max-width: 620px) {
        .blog-post h1:first-of-type {
            font-size: 2.3rem;
            margin-bottom: 1rem;
        }

        .blog-post h2 {
            font-size: 1.4rem;
        }

        .blog-post h3 {
            font-size: 1.18rem;
        }

        .blog-post .abstract {
            padding: 1rem 1.1rem;
        }

        .blog-post .post-body > p:first-of-type::first-letter {
            font-size: 2.9em;
        }
    }
</style>
